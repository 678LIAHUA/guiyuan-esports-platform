# Server
PORT=8787
PAY_BASE_URL=http://127.0.0.1:8787

# Bootstrap accounts: set strong unique passwords before first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
BOOTSTRAP_STAFF_USERNAME=support
BOOTSTRAP_STAFF_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Player workbench
GLOBAL_PLAYER_WORKBENCH_SECRET=

# WeChat mini program and message callback
WECHAT_MINI_APPID=wx0000000000000000
WECHAT_MINI_SECRET=
WECHAT_MESSAGE_TOKEN=

# WeChat service account / JSAPI payment
WECHAT_SERVICE_APPID=
WECHAT_SERVICE_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/secure/path/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/pay/notify
WECHAT_PAY_MOCK=1

# WeChat virtual payment
WECHAT_VIRTUAL_PAY_OFFER_ID=
WECHAT_VIRTUAL_PAY_APP_KEY=
