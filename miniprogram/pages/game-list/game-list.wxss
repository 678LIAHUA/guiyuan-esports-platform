page {
  height: 100vh;
  overflow: hidden;
}

.game-list {
  height: calc(100vh - 88rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(circle at 88% 8%, rgba(255, 221, 128, .22), transparent 24%),
    linear-gradient(180deg, #f7f4ff 0%, #eee9ff 48%, #f8f6ff 100%);
}

.list-head {
  flex: none;
  margin: 16rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .78);
  border: 1rpx solid rgba(126, 100, 238, .12);
  box-shadow: 0 12rpx 26rpx rgba(87, 69, 168, .08);
}

.head-title {
  color: #241c4d;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.head-desc {
  margin-top: 8rpx;
  color: #777092;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.games-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  margin-top: 14rpx;
}

.games-grid {
  padding: 0 24rpx 126rpx;
}

.game-card {
  min-height: 132rpx;
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr) 92rpx;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 92% 14%, rgba(255, 224, 129, .18), transparent 23%),
    linear-gradient(145deg, #ffffff, #f3efff);
  border: 1rpx solid rgba(126, 100, 238, .12);
  box-shadow:
    inset 0 3rpx 0 rgba(255, 255, 255, .9),
    0 12rpx 24rpx rgba(82, 63, 158, .1);
}

.game-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #eee9ff;
  box-shadow: 0 8rpx 15rpx rgba(75, 55, 145, .12);
}

.game-info {
  min-width: 0;
}

.game-name {
  color: #241c4d;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #7b7398;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 26rpx;
}

.game-meta text {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(126, 100, 238, .08);
}

.enter-btn {
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #9a7cff, #6e4bea);
  box-shadow: 0 8rpx 15rpx rgba(112, 76, 226, .24);
}

@media (max-width: 340px) {
  .list-head,
  .games-grid {
    margin-left: 18rpx;
    margin-right: 18rpx;
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .games-grid {
    padding-bottom: 116rpx;
  }

  .game-card {
    grid-template-columns: 76rpx minmax(0, 1fr) 78rpx;
    gap: 12rpx;
    padding: 14rpx;
  }

  .game-icon {
    width: 76rpx;
    height: 76rpx;
  }

  .game-name {
    font-size: 26rpx;
  }

  .enter-btn {
    font-size: 20rpx;
  }
}
