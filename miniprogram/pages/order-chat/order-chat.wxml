<navigation-bar title="消息" back="{{false}}" background="transparent"></navigation-bar>

<view class="page order-chat">
  <view class="chat-room" wx:if="{{activeGroup}}">
    <view class="group-head card">
      <button bindtap="back">‹</button>
      <view>
        <text class="group-title">{{activeGroup.title}}</text>
        <text class="group-sub">订单号 {{activeGroup.orderNo}} · 客服 {{activeGroup.service.name}} · 达人 {{playerCount}} 人</text>
      </view>
      <view class="status">{{statusText}}</view>
    </view>

    <scroll-view class="message-list" scroll-y enable-flex scroll-into-view="{{chatBottomId}}">
      <view
        class="bubble-row {{item.role}}"
        wx:for="{{activeGroup.messages}}"
        wx:key="id"
      >
        <view wx:if="{{item.showAvatar}}" class="chat-avatar-wrap">
          <image wx:if="{{item.avatar}}" class="chat-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <text wx:else>{{item.avatarText}}</text>
        </view>
        <view class="bubble">
          <view class="sender">{{item.sender}} · {{item.time}}</view>
          <image
            wx:if="{{item.type === 'image'}}"
            class="chat-image"
            src="{{item.imageUrl}}"
            mode="aspectFill"
            data-url="{{item.imageUrl}}"
            bindtap="previewImage"
          ></image>
          <view wx:else class="text">{{item.text}}</view>
        </view>
      </view>
      <view id="boss-chat-bottom" class="chat-bottom-anchor"></view>
    </scroll-view>

    <view class="finish-confirm-card" wx:if="{{hasFinishRequest}}">
      <view>
        <text>结单确认</text>
        <text>{{finishRequestText}}</text>
        <view class="settlement-box" wx:if="{{showSettlementInput}}">
          <input
            value="{{actualMinutesInput}}"
            type="number"
            placeholder="填写实际服务分钟"
            placeholder-class="placeholder"
            bindinput="onActualMinutesInput"
          />
          <text>{{refundPreviewText}}</text>
        </view>
      </view>
      <button bindtap="confirmFinish">确认结单</button>
    </view>

    <view class="input-bar">
      <button class="image-btn" bindtap="chooseImage">＋</button>
      <input
        value="{{inputText}}"
        placeholder="给客服和达人发消息"
        placeholder-class="placeholder"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="sendMessage"
      />
      <button bindtap="sendMessage">发送</button>
    </view>
  </view>
</view>
