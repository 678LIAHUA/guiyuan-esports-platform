page {
  min-height: 100vh;
  background: #111018;
}

.crop-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #111018;
}

.crop-wrap {
  padding-top: 42rpx;
}

.crop-frame {
  position: relative;
  width: 100%;
  height: 398rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #262331;
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, .28);
}

.crop-image {
  position: absolute;
  display: block;
}

.crop-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  border: 4rpx solid rgba(255, 255, 255, .88);
  box-sizing: border-box;
}

.crop-grid view {
  position: absolute;
  background: rgba(255, 255, 255, .38);
}

.crop-grid view:nth-child(1),
.crop-grid view:nth-child(2) {
  top: 0;
  bottom: 0;
  width: 2rpx;
}

.crop-grid view:nth-child(1) {
  left: 33.33%;
}

.crop-grid view:nth-child(2) {
  left: 66.66%;
}

.crop-grid view:nth-child(3),
.crop-grid view:nth-child(4) {
  left: 0;
  right: 0;
  height: 2rpx;
}

.crop-grid view:nth-child(3) {
  top: 33.33%;
}

.crop-grid view:nth-child(4) {
  top: 66.66%;
}

.crop-tip {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, .72);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.scale-card {
  min-height: 108rpx;
  margin-top: 44rpx;
  padding: 18rpx 22rpx;
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, .92);
}

.scale-card text {
  color: #211a4f;
  font-size: 25rpx;
  font-weight: 900;
}

.save-btn {
  width: 100%;
  height: 82rpx;
  margin-top: 34rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8c59ff, #7046df);
  box-shadow: 0 16rpx 34rpx rgba(112, 70, 223, .26);
}

.crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 430px;
}
