page {
  height: 100vh;
  overflow: hidden;
}

.game-orders {
  height: calc(100vh - 88rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 10%, rgba(255, 221, 128, .22), transparent 23%),
    linear-gradient(180deg, #f7f4ff 0%, #eee9ff 48%, #f8f6ff 100%);
}

.game-head {
  flex: none;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 14rpx 20rpx 0;
  padding: 16rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .78);
  border: 1rpx solid rgba(126, 100, 238, .12);
  box-shadow: 0 10rpx 22rpx rgba(87, 69, 168, .08);
}

.game-logo {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 22rpx;
  background: #eee9ff;
}

.game-copy {
  min-width: 0;
}

.game-name {
  color: #241c4d;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.game-tip {
  margin-top: 4rpx;
  color: #777092;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.order-layout {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 178rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 14rpx 20rpx 126rpx;
}

.category-panel,
.goods-panel {
  min-height: 0;
  height: 100%;
}

.category-panel {
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .64);
  border: 1rpx solid rgba(126, 100, 238, .12);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .8);
}

.category-item {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  color: #332a5b;
  font-size: 24rpx;
  font-weight: 800;
}

.category-item text {
  max-width: 100%;
  line-height: 30rpx;
  text-align: center;
}

.category-item.active {
  color: #fff;
  background: linear-gradient(135deg, #9a7cff, #6e4bea);
  box-shadow:
    inset 0 3rpx 8rpx rgba(255, 255, 255, .2),
    0 10rpx 20rpx rgba(112, 76, 226, .2);
}

.category-item.active::before {
  content: "";
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 7rpx;
  border-radius: 999rpx;
  background: #ffe58c;
}

.goods-panel {
  overflow: hidden;
}

.goods-card {
  min-height: 194rpx;
  display: grid;
  grid-template-columns: 138rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 224, 129, .18), transparent 24%),
    linear-gradient(145deg, #ffffff, #f3efff);
  border: 1rpx solid rgba(126, 100, 238, .12);
  box-shadow:
    inset 0 3rpx 0 rgba(255, 255, 255, .9),
    0 12rpx 24rpx rgba(82, 63, 158, .1);
}

.goods-img {
  width: 138rpx;
  height: 138rpx;
  align-self: center;
  border-radius: 26rpx;
  background: #eee9ff;
  box-shadow: 0 10rpx 18rpx rgba(75, 55, 145, .14);
}

.goods-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods-title {
  color: #241c4d;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 34rpx;
  max-height: 68rpx;
  overflow: hidden;
}

.goods-desc {
  margin-top: 6rpx;
  color: #5f5680;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 29rpx;
  max-height: 58rpx;
  overflow: hidden;
}

.goods-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
  margin-top: 8rpx;
  color: #8a82a2;
  font-size: 19rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
}

.goods-tag {
  flex: none;
  padding: 3rpx 9rpx;
  color: #fff;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #64d890, #32bd75);
}

.goods-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
}

.price-label {
  color: #7b7398;
  font-size: 18rpx;
  font-weight: 800;
}

.now-price {
  color: #ff7b2f;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 32rpx;
  white-space: nowrap;
}

.order-btn {
  flex: none;
  height: 42rpx;
  min-width: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #9a7cff, #6e4bea);
  box-shadow: 0 6rpx 12rpx rgba(112, 76, 226, .2);
}

.empty {
  margin: 60rpx 28rpx 0;
  padding: 46rpx 30rpx;
  text-align: center;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .78);
  border: 1rpx solid rgba(126, 100, 238, .12);
}

.empty-title {
  color: #241c4d;
  font-size: 28rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #7b7398;
  font-size: 23rpx;
  font-weight: 700;
}

@media (max-width: 340px) {
  .order-layout {
    grid-template-columns: 156rpx minmax(0, 1fr);
    gap: 10rpx;
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .category-item {
    height: 82rpx;
    font-size: 21rpx;
  }

  .goods-card {
    grid-template-columns: 112rpx minmax(0, 1fr);
    gap: 12rpx;
    padding: 12rpx;
  }

  .goods-img {
    width: 112rpx;
    height: 112rpx;
  }

  .goods-title {
    font-size: 23rpx;
    line-height: 30rpx;
  }

  .goods-desc {
    font-size: 19rpx;
    line-height: 25rpx;
  }

  .goods-meta {
    font-size: 17rpx;
  }

  .now-price {
    font-size: 23rpx;
  }
}
