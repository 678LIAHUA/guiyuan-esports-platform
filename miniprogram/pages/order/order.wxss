page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7f4ff;
}

.confirm-page {
  flex: 1;
  min-height: 0;
  background:
    radial-gradient(circle at 12% 4%, rgba(255, 221, 236, .66), transparent 240rpx),
    radial-gradient(circle at 88% 8%, rgba(218, 210, 255, .9), transparent 260rpx),
    linear-gradient(180deg, #f7f4ff 0%, #fbfaff 48%, #ffffff 100%);
}

.content {
  padding: 24rpx 28rpx calc(190rpx + env(safe-area-inset-bottom));
}

.confirm-card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .9);
  border: 1rpx solid rgba(116, 88, 221, .1);
  box-shadow: 0 16rpx 36rpx rgba(74, 57, 145, .09);
}

.confirm-card + .confirm-card {
  margin-top: 22rpx;
}

.card-title {
  color: #171331;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.product-main {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 120rpx minmax(0, 1fr) 116rpx;
  align-items: start;
  gap: 18rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(116, 88, 221, .08);
}

.product-main image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 22rpx;
  background: #eee9ff;
}

.product-main > view:nth-child(2) {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.product-main > view:nth-child(2) text:first-child {
  color: #171331;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 36rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-main > view:nth-child(2) text:last-child {
  color: #756d94;
  font-size: 22rpx;
  font-weight: 800;
}

.product-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
}

.product-price text:first-child {
  color: #ff4f68;
  font-size: 30rpx;
  font-weight: 900;
}

.product-price text:last-child {
  color: #9189a6;
  font-size: 21rpx;
  font-weight: 800;
}

.spec-row {
  min-height: 84rpx;
  margin-top: 22rpx;
  padding: 0 16rpx;
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  border-radius: 20rpx;
  background: #f3f0ff;
  border: 1rpx solid rgba(116, 88, 221, .1);
}

.spec-row > text {
  height: 42rpx;
  color: #fff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #9174ff, #6845df);
}

.spec-row > view {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.spec-row > view text:first-child {
  min-width: 0;
  color: #171331;
  font-size: 25rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-row > view text:last-child {
  flex: none;
  color: #7357ee;
  font-size: 22rpx;
  font-weight: 900;
}

.tier-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tier-item {
  min-height: 70rpx;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  border-radius: 18rpx;
  background: #fbfaff;
  border: 2rpx solid transparent;
}

.tier-item.active {
  background: #f0ebff;
  border-color: rgba(116, 88, 221, .38);
}

.tier-item text:first-child {
  min-width: 0;
  color: #171331;
  font-size: 23rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tier-item text:last-child {
  flex: none;
  color: #ff4f68;
  font-size: 22rpx;
  font-weight: 900;
}

.amount-row,
.pay-row,
.input-row,
.assign-row,
.quantity-row {
  min-height: 76rpx;
  display: grid;
  grid-template-columns: 158rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
}

.amount-row {
  margin-top: 12rpx;
}

.amount-row text:first-child,
.pay-row text:first-child,
.input-row > text,
.assign-row > text,
.quantity-row > text {
  color: #3a3353;
  font-size: 25rpx;
  font-weight: 900;
}

.amount-row text:last-child,
.pay-row text:last-child {
  color: #ff4f68;
  font-size: 25rpx;
  font-weight: 900;
  text-align: right;
}

.amount-row:nth-of-type(2) text:last-child {
  color: #9189a6;
}

.pay-row {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(116, 88, 221, .12);
}

.pay-row text:first-child {
  font-size: 30rpx;
}

.pay-row text:last-child {
  font-size: 32rpx;
}

.form-card .card-title {
  margin-bottom: 16rpx;
}

.input-row input {
  width: 100%;
  height: 70rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: #171331;
  font-size: 25rpx;
  font-weight: 800;
  text-align: right;
  border-radius: 18rpx;
  background: #f7f4ff;
}

.input-placeholder {
  color: #aaa3bd;
  font-weight: 700;
}

.assign-row > view {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 22rpx;
  flex-wrap: wrap;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #756d94;
  font-size: 25rpx;
  font-weight: 900;
}

.radio-item > text:first-child {
  width: 38rpx;
  height: 38rpx;
  box-sizing: border-box;
  border: 4rpx solid #aaa3bd;
  border-radius: 50%;
  background: #fff;
}

.radio-item.active {
  color: #7357ee;
}

.radio-item.active > text:first-child {
  border-color: #7357ee;
  background:
    radial-gradient(circle at center, #7357ee 0 38%, transparent 42%),
    #fff;
}

.quantity-row {
  margin-top: 6rpx;
}

.stepper {
  width: 224rpx;
  height: 64rpx;
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  justify-self: end;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #ececf2;
}

.stepper button {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  color: #171331;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 60rpx;
  border-radius: 0;
  background: #fff;
}

.stepper button.disabled {
  color: #c7c4cf;
}

.stepper button::after {
  border: 0;
}

.stepper text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #171331;
  font-size: 28rpx;
  font-weight: 900;
  border-left: 2rpx solid #ececf2;
  border-right: 2rpx solid #ececf2;
}

.bottom-submit {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  min-height: calc(164rpx + env(safe-area-inset-bottom));
  padding: 10rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(251, 250, 255, 0), rgba(251, 250, 255, .97) 22%, #fbfaff);
}

.agreement {
  height: 48rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #756d94;
  font-size: 22rpx;
  font-weight: 800;
}

.agreement text:first-child {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(117, 109, 148, .4);
  background: #fff;
}

.agreement text:first-child.checked {
  border-color: #7357ee;
  background:
    linear-gradient(135deg, transparent 48%, #fff 49% 56%, transparent 57%),
    linear-gradient(45deg, transparent 44%, #fff 45% 56%, transparent 57%),
    #7357ee;
}

.agreement text:last-child {
  color: #7357ee;
}

.submit-line {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 250rpx;
  align-items: center;
  gap: 18rpx;
}

.submit-line > view {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.submit-line > view text:first-child {
  color: #171331;
  font-size: 25rpx;
  font-weight: 900;
}

.submit-line > view text:last-child {
  color: #ff4f68;
  font-size: 32rpx;
  font-weight: 900;
}

.submit-line button,
.picker-confirm {
  width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #9174ff, #6845df);
  box-shadow: 0 16rpx 34rpx rgba(112, 70, 223, .24);
}

.submit-line button::after,
.picker-confirm::after {
  border: 0;
}

.picker-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 24rpx 34rpx;
  box-sizing: border-box;
  background: rgba(20, 16, 40, .48);
}

.player-picker {
  width: 100%;
  max-height: 78vh;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 -18rpx 46rpx rgba(26, 20, 62, .18);
}

.picker-head {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-head text:first-child {
  color: #171331;
  font-size: 32rpx;
  font-weight: 900;
}

.picker-head text:last-child {
  width: 54rpx;
  height: 54rpx;
  color: #756d94;
  font-size: 46rpx;
  line-height: 50rpx;
  text-align: center;
}

.picker-search {
  height: 74rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr);
  align-items: center;
  gap: 10rpx;
  border-radius: 22rpx;
  background: #f7f4ff;
}

.picker-search > text {
  color: #756d94;
  font-size: 32rpx;
  font-weight: 900;
}

.picker-search input {
  width: 100%;
  height: 74rpx;
  color: #171331;
  font-size: 25rpx;
  font-weight: 800;
}

.picker-list {
  height: 560rpx;
  max-height: 52vh;
  margin-top: 14rpx;
}

.picker-player {
  min-height: 104rpx;
  display: grid;
  grid-template-columns: 42rpx 72rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(116, 88, 221, .08);
}

.picker-player.active .picker-radio {
  border-color: #7357ee;
  background:
    radial-gradient(circle at center, #7357ee 0 38%, transparent 42%),
    #fff;
}

.picker-radio {
  width: 38rpx;
  height: 38rpx;
  box-sizing: border-box;
  border: 4rpx solid #aaa3bd;
  border-radius: 50%;
  background: #fff;
}

.picker-player image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #eee9ff;
}

.picker-player > view:last-child {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.picker-player > view:last-child text:first-child {
  color: #171331;
  font-size: 26rpx;
  font-weight: 900;
}

.picker-player > view:last-child text:last-child {
  color: #756d94;
  font-size: 21rpx;
  font-weight: 800;
}

.picker-confirm {
  margin-top: 18rpx;
}
