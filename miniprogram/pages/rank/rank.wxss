/* pages/rank/rank.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.rank {
  flex: 1;
  min-height: 0;
}

.content {
  padding: 0 24rpx 24rpx;
}

.tabs {
  height: 66rpx;
  display: flex;
  padding: 6rpx;
  margin: 8rpx 0 22rpx;
}

.tab {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #655d84;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.tab.active {
  color: #5840d8;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(102, 76, 224, .16);
}

.rank-note {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 18rpx;
}

.rank-note text:first-child {
  min-width: 0;
  color: #342b62;
  font-size: 24rpx;
  font-weight: 800;
}

.rank-note text:last-child {
  flex: none;
  color: #7d739e;
  font-size: 21rpx;
}

.podium {
  min-height: 420rpx;
  display: flex;
  align-items: end;
  padding: 26rpx 20rpx 24rpx;
}

.rank-loading,
.rank-empty {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #776e92;
  font-size: 24rpx;
  font-weight: 800;
}

.rank-empty text:first-child {
  color: #28224b;
  font-size: 30rpx;
  font-weight: 900;
}

.rank-empty text:last-child {
  color: #8a829d;
  font-size: 22rpx;
  font-weight: 700;
}

.podium-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin-right: 10rpx;
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f5f0ff, #ffffff);
}

.podium-item:last-child {
  margin-right: 0;
}

.podium-item:nth-child(2) {
  min-height: 340rpx;
  background: linear-gradient(180deg, #fff6ce, #ffe7a5);
  box-shadow: 0 14rpx 28rpx rgba(229, 173, 64, .2);
}

.podium-item:nth-child(1),
.podium-item:nth-child(3) {
  min-height: 280rpx;
}

.crown {
  height: 38rpx;
  color: #7658e8;
  font-size: 30rpx;
  font-weight: 900;
}

.podium image {
  width: 112rpx;
  height: 112rpx;
  margin: 10rpx 0;
  border: 5rpx solid #fff;
  border-radius: 34rpx;
  box-shadow: 0 10rpx 22rpx rgba(73, 55, 154, .16);
}

.name {
  color: #191633;
  font-size: 30rpx;
  font-weight: 900;
}

.money {
  margin-top: 8rpx;
  color: #171331;
  font-size: 28rpx;
  font-weight: 900;
}

.orders {
  margin-top: 4rpx;
  color: #756d92;
  font-size: 22rpx;
}

.rank-list {
  margin-top: 22rpx;
  padding: 8rpx 20rpx;
}

.rank-row {
  height: 108rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(111, 91, 188, .1);
}

.rank-row:last-child {
  border-bottom: 0;
}

.num {
  width: 42rpx;
  flex: none;
  color: #2a2450;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.rank-row image {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  margin-left: 14rpx;
  border-radius: 22rpx;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-left: 14rpx;
}

.info .name {
  font-size: 27rpx;
}

.info text:last-child,
.right text:last-child {
  color: #847b9c;
  font-size: 21rpx;
}

.right {
  width: 150rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.right text:first-child {
  color: #171331;
  font-size: 25rpx;
  font-weight: 900;
}

.mine-card {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  margin-top: 22rpx;
  color: #6c52e6;
  font-size: 26rpx;
  font-weight: 900;
}
