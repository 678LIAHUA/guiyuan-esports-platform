<navigation-bar title="全部达人" background="transparent"></navigation-bar>

<scroll-view class="page player-list safe-bottom" scroll-y>
  <view class="content">
    <view class="list-head">
      <text>全部达人信息</text>
      <text>查看在线状态、评分、服务量和价格</text>
      <view class="search-box">
        <text>⌕</text>
        <input
          value="{{searchKeyword}}"
          placeholder="搜索达人昵称 / ID / 标签"
          placeholder-class="search-placeholder"
          bindinput="onSearchInput"
          confirm-type="search"
          bindconfirm="confirmSearch"
        />
        <button wx:if="{{searchKeyword}}" bindtap="clearSearch">×</button>
      </view>
      <view class="result-line">{{resultText}}</view>
    </view>

    <view
      class="featured-player"
      wx:if="{{hasFeaturedPlayer}}"
      data-player-id="{{featuredPlayer.id}}"
      bindtap="openDetail"
    >
      <image src="{{featuredPlayer.avatar}}" mode="aspectFill"></image>
      <view>
        <view class="featured-top">
          <text>{{featuredPlayer.name}}</text>
          <text>{{matchText}}</text>
        </view>
        <view class="featured-meta">
          <text>评分 {{featuredPlayer.score}}</text>
          <text>服务 {{featuredPlayer.served}} 人</text>
          <text>{{featuredPlayer.price}} 猫粮/小时</text>
        </view>
        <view class="featured-tags">
          <text wx:for="{{featuredPlayer.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>

    <block wx:if="{{players.length}}">
      <view
        class="player-item"
        wx:for="{{players}}"
        wx:key="id"
        data-player-id="{{item.id}}"
        bindtap="openDetail"
      >
        <image class="player-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view class="player-main">
          <view class="player-top">
            <text class="player-name">{{item.name}}</text>
            <text class="status {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="player-meta">
            <text>评分 {{item.score}}</text>
            <text>服务 {{item.served}} 人</text>
            <text>{{item.price}} 猫粮/小时</text>
          </view>
          <view class="tag-row">
            <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
          </view>
          <text class="player-desc">{{item.desc}}</text>
        </view>
      </view>
    </block>
    <view class="empty-search" wx:else>
      <text>没有找到匹配达人</text>
      <text>换个昵称、ID 或标签试试</text>
    </view>
  </view>
</scroll-view>
